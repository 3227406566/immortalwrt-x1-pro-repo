+  DEVICE_VENDOR := Oray
+  DEVICE_MODEL := X1 Pro
+  DEVICE_DTS := mt7981b-oray-x1-pro
+  DEVICE_DTS_DIR := ../dts
+  DEVICE_PACKAGES := kmod-mt7981-firmware mt7981-2.5g-firmware wpad-openssl
+  SUPPORTED_DEVICES += oray,x1-pro
+endef
+TARGET_DEVICES += oray_x1-pro
+
 define Device/zyxel_ex5601-t0
   DEVICE_VENDOR := Zyxel
   DEVICE_MODEL := EX5601-T0
   DEVICE_DTS := mt7981b-zyxel-ex5601-t0
